@model IEnumerable<CarRentalApp.Models.Car>

@{
    ViewData["Title"] = "Booked Cars";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Booked Cars</h2>
    <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-primary">Back to Cars</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No cars have been booked yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Car Name</th>
                    <th>Price Per Day</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>@car.Id</td>
                        <td>@car.Name</td>
                        <td>PKR @car.PricePerDay.ToString("N0")</td>
                        <td>
                            <span class="badge bg-warning text-dark">Booked</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}